# 环境变量
.env

# 临时脚本与运行产物
warn_*.py
stay_*.py
*.log
verified_*.json
cracked_*.json
rescan*.py
# 以下源文件被上面的通配命中但必须入库（删了再加会静默消失）
!service/warn_service.py
!scanner/rescanner.py
!storage/rescan.py

# 通用忽略，白名单必要配置。
# 这里刻意保留 *.json / *.txt 的「全忽略 + 白名单」，而不是改成目录白名单：
# auth.json 等凭据文件没有独立规则，只靠 *.json 兜住，删掉通配会直接把凭据
# 变成可提交状态。代价是新增的 json/txt 资源会被静默忽略，所以：
# 新增源码/文档资源时请在本段显式登记，或放进下面已放开的源码目录。
*.json
!config.example.json
!package.json
# PWA 清单是前端资源，不是运行期配置，必须入库（否则 /manifest.json 永远 404）
!web/static/manifest.json
# 源码/文档目录下的资源默认入库，降低「新增资源被静默忽略」的影响
!docs/**/*.json
!tools/**/*.json
!tests/**/*.json
*.txt
!requirements.txt
!targets.txt
!docs/**/*.txt
!tools/**/*.txt

# 聊天记录 / 观察者导出（勿提交）
chat_log_*.html
chat_log_*.txt
duel_chat_*.html
provoke_chat_*.html
observer_logs/
*.html
!web/index.html

# 本地私密配置
config.local.json
config.json

# 个人/实验脚本（不进仓库）
find_*.py
run_*_bot.py
monitor_*.py
debug_*.py
!tests/
# 数据文件
*.zip
online_servers.json
all_servers_status.json
mc_servers_clean.json
observer_logs/
mcscanner.db
favorites.json
